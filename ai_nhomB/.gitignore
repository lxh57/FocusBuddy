# =============================================
# FocusBuddy .gitignore
# =============================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# --- Môi trường ảo ---
venv/
.venv/
env/

# --- Biến môi trường (chứa API key) ---
.env

# --- Model files (quá nặng để đẩy lên git) ---
models/
*.pt
*.pth
*.bin
*.onnx
*.h5

# --- Data files ---
data/raw/
data/processed/

# --- Output files ---
outputs/
*.mp3
*.wav
*.ogg

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
~$*

# --- Jupyter ---
.ipynb_checkpoints/
notebooks/*.html

# --- OS ---
.DS_Store
Thumbs.db
*.tmp
*.docx

# --- Misc ---
*.log
